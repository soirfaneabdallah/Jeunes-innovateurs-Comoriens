tatic/chunks/86d80384f77bdfc9.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/937ab3bfb9adab6e.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/01f4b20cb37151b1.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/ed6a129439d553b4.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/8b7a6316c3557781.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/973b0453c9add2a6.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/94211778aaa277c7.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/dd46b60db475ca23.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/74a9e22e5d517b67.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/7d1fd14435d328e4.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/e16e52202b402dda.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/e92309faf83811de.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\"],\"default\",1]\n"])</script><script>self.__next_f.push([1,"5a:T1fc8,"])</script><script>self.__next_f.push([1,"(function () {\n    var STORAGE_KEY = \"anaconda_docs_dropdown_tooltip_dismissed\";\n    var TRIGGER_SELECTOR = '[data-component-part=\"products-selector-trigger\"]';\n  \n    // ── Don't show if already dismissed ──────────────────────────────────────\n    if (localStorage.getItem(STORAGE_KEY)) return;\n  \n    // ── Theme token sets ──────────────────────────────────────────────────────\n    // Dark mode: primary green fill (#08ca4a) with near-black text (#10121a),\n    //   matching the Download button treatment.\n    // Light mode: blue fill (#1d6cf7) with white text, matching nav active\n    //   indicator and sidebar hover treatment.\n    var THEMES = {\n      dark: {\n        background:   \"#08ca4a\",\n        text:         \"#10121a\",\n        textMuted:    \"#0c2b12\",\n        textStrong:   \"#10121a\",\n        dismissColor: \"#0c3318\",\n        dismissHover: \"#10121a\",\n        shadow:       \"0 8px 28px rgba(8, 202, 74, 0.35)\",\n      },\n      light: {\n        background:   \"#1d6cf7\",\n        text:         \"#ffffff\",\n        textMuted:    \"#dde9fe\",\n        textStrong:   \"#ffffff\",\n        dismissColor: \"#bdd4fd\",\n        dismissHover: \"#ffffff\",\n        shadow:       \"0 8px 28px rgba(29, 108, 247, 0.35)\",\n      },\n    };\n  \n    function getTheme() {\n      return document.documentElement.classList.contains(\"dark\") ? \"dark\" : \"light\";\n    }\n  \n    // ── Check if trigger button is visible ───────────────────────────────────\n    // The dropdown has `max-lg:hidden` in its Tailwind classes, so on mobile\n    // it is present in the DOM but hidden via display:none. We check for this\n    // and skip rendering entirely if the button isn't actually visible.\n    function isTriggerVisible() {\n      var btn = document.querySelector(TRIGGER_SELECTOR);\n      if (!btn) return false;\n      return getComputedStyle(btn).display !== \"none\";\n    }\n  \n    // ── Build tooltip DOM ─────────────────────────────────────────────────────\n    var tooltip    = document.createElement(\"div\");\n    var arrow      = document.createElement(\"div\");\n    var dismissBtn = document.createElement(\"button\");\n    var heading    = document.createElement(\"p\");\n    var body       = document.createElement(\"p\");\n  \n    tooltip.setAttribute(\"role\", \"dialog\");\n    tooltip.setAttribute(\"aria-modal\", \"false\");\n    tooltip.setAttribute(\"aria-label\", \"Navigation tip\");\n  \n    arrow.setAttribute(\"aria-hidden\", \"true\");\n  \n    dismissBtn.setAttribute(\"aria-label\", \"Dismiss tip\");\n    dismissBtn.textContent = \"✕\";\n  \n    // TODO: Replace with final heading copy\n    heading.textContent = \"Browse documentation\";\n  \n    // TODO: Replace with final body copy\n    body.innerHTML = 'Use this dropdown to navigate to any product\\'s documentation.';\n  \n    tooltip.appendChild(arrow);\n    tooltip.appendChild(dismissBtn);\n    tooltip.appendChild(heading);\n    tooltip.appendChild(body);\n  \n    // ── Apply styles ──────────────────────────────────────────────────────────\n    function applyStyles(t) {\n      Object.assign(tooltip.style, {\n        position:        \"fixed\",\n        zIndex:          \"9999\",\n        width:           \"240px\",\n        borderRadius:    \"8px\",\n        padding:         \"14px 16px 14px 14px\",\n        backgroundColor: t.background,\n        color:           t.text,\n        boxShadow:       t.shadow,\n        fontFamily:      \"inherit\",\n        fontSize:        \"13px\",\n        lineHeight:      \"1.5\",\n        overflow:        \"visible\",\n        transition:      \"background-color 0.2s, color 0.2s, box-shadow 0.2s\",\n      });\n  \n      // Rotated square: half sits above the tooltip top edge, half is hidden\n      // behind the tooltip body, giving a clean seamless join at any border-radius.\n      Object.assign(arrow.style, {\n        position:        \"absolute\",\n        top:             \"-6px\",\n        width:           \"12px\",\n        height:          \"12px\",\n        backgroundColor: t.background,\n        transform:       \"rotate(45deg)\",\n        borderRadius:    \"2px 0 0 0\",\n        transition:      \"background-color 0.2s\",\n      });\n  \n      Object.assign(dismissBtn.style, {\n        position:     \"absolute\",\n        top:          \"8px\",\n        right:        \"8px\",\n        background:   \"none\",\n        border:       \"none\",\n        cursor:       \"pointer\",\n        color:        t.dismissColor,\n        fontSize:     \"16px\",\n        lineHeight:   \"1\",\n        padding:      \"2px 4px\",\n        borderRadius: \"4px\",\n        transition:   \"color 0.15s\",\n      });\n  \n      Object.assign(heading.style, {\n        margin:     \"0 20px 6px 0\",\n        fontWeight: \"600\",\n        color:      t.textStrong,\n      });\n  \n      Object.assign(body.style, {\n        margin: \"0\",\n        color:  t.textMuted,\n      });\n  \n      var strong = body.querySelector(\"strong\");\n      if (strong) strong.style.color = t.text;\n  \n      dismissBtn._dismissColor = t.dismissColor;\n      dismissBtn._dismissHover = t.dismissHover;\n      dismissBtn.style.color   = t.dismissColor;\n    }\n  \n    // ── Position tooltip under the trigger button ─────────────────────────────\n    function updatePosition() {\n      var btn = document.querySelector(TRIGGER_SELECTOR);\n      if (!btn) return;\n  \n      // Hide tooltip if the button is no longer visible (e.g. window resized\n      // down to mobile width after the tooltip was already shown)\n      if (!isTriggerVisible()) {\n        tooltip.style.display = \"none\";\n        return;\n      }\n  \n      tooltip.style.display = \"\";\n      var rect = btn.getBoundingClientRect();\n      tooltip.style.top  = (rect.bottom + 10) + \"px\";\n      tooltip.style.left = rect.left + \"px\";\n      // Center the arrow over the button\n      var arrowLeft = Math.round(rect.width / 2) - 6;\n      arrow.style.left = arrowLeft + \"px\";\n    }\n  \n    // ── Event listeners ───────────────────────────────────────────────────────\n    dismissBtn.addEventListener(\"mouseenter\", function () {\n      dismissBtn.style.color = dismissBtn._dismissHover;\n    });\n    dismissBtn.addEventListener(\"mouseleave\", function () {\n      dismissBtn.style.color = dismissBtn._dismissColor;\n    });\n    dismissBtn.addEventListener(\"click\", function () {\n      localStorage.setItem(STORAGE_KEY, \"true\");\n      document.body.removeChild(tooltip);\n      resizeObserver.disconnect();\n      mutationObserver.disconnect();\n    });\n  \n    // ── Observers ─────────────────────────────────────────────────────────────\n    var resizeObserver = new ResizeObserver(updatePosition);\n  \n    var mutationObserver = new MutationObserver(function () {\n      applyStyles(THEMES[getTheme()]);\n    });\n  \n    // ── Init on DOM ready ─────────────────────────────────────────────────────\n    function init() {\n      // Don't render at all if the trigger isn't visible on first load\n      if (!isTriggerVisible()) return;\n  \n      applyStyles(THEMES[getTheme()]);\n      document.body.appendChild(tooltip);\n      updatePosition();\n  \n      resizeObserver.observe(document.documentElement);\n      mutationObserver.observe(document.documentElement, {\n        attributes:      true,\n        attributeFilter: [\"class\"],\n      });\n    }\n  \n    if (document.readyState === \"loading\") {\n      document.addEventListener(\"DOMContentLoaded\", init);\n    } else {\n      init();\n    }\n  })();"])</script><script>self.__next_f.push([1,"57:[\"$\",\"$L59\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"67fe90fda310f0d3789f8fe4\",\"filePath\":\"_transcend.js\",\"subdomain\":\"anaconda-29683c67\",\"__v\":0,\"content\":\"function insertTranscendScript() {\\n\\n  const transcendScript = document.createElement('script');\\n  transcendScript.setAttribute('data-cfasync', 'false');\\n  transcendScript.setAttribute('src', 'https://transcend-cdn.com/cm/471944e6-c8d1-4cfe-902c-0ed1695b7053/airgap.js');\\n  \\n  const head = document.head || document.getElementsByTagName('head')[0];\\n  \\n  if (head.firstChild) {\\n    head.insertBefore(transcendScript, head.firstChild);\\n  } else {\\n    head.appendChild(transcendScript);\\n  }\\n}\\n\\nif (document.readyState === 'loading') {\\n  document.addEventListener('DOMContentLoaded', insertTranscendScript);\\n} else {\\n  insertTranscendScript();\\n}\"},{\"_id\":\"6a43ee39436d2197bee88dc3\",\"filePath\":\"docs-dropdown-tooltip.js\",\"subdomain\":\"anaconda-29683c67\",\"__v\":0,\"content\":\"$5a\"}]}]\n"])</script><script>self.__next_f.push([1,"5d:T10b4,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provi