ation\"},\"isPartOf\":{\"@id\":\"https://www.anaconda.com/docs#website\"}}]}"])</script><script>self.__next_f.push([1,"56:Tc63a,"])</script><script>self.__next_f.push([1,"/* --------- */\n/* VARIABLES */\n/* --------- */\n\n:root {\n    --light-background: #f4f5f8;\n    --dark-background: #10121a;\n    --primary-hex: #08ca4a; /* Primary Green-light-9 */\n    --primary-rgb: 8 202 74; /* Primary Green-Light-9 */\n    --primary-hex-dark: #96f778; /* Primary Green-Dark-10 */\n    --info-hex: #1d6cf7; /* Blue-Light-7 */\n    --info-rgb: 29 109 247; /* Blue-Light-7 */\n    --info-hover-rgb: rgb(22 82 185); /* Blue-Light-10 */\n    --info-hex-dark: #96f778; /* Primary Green-Dark-10 */\n    --info-rgb-dark: 150 247 120; /* Primary Green-Dark-10 */\n    --info-hover-rgb-dark: rgb(198 242 171); /* Primary Green-Dark-11 */\n    --secondary-hover-hex: #090909; /* Jet-Light-13 */\n    --secondary-hover-hex-dark: #3a3a3a; /*Jet-Dark-12 */\n    --on-primary-hex: #0c0c0c; /* Jet-Light-12 */\n    --on-primary-rgb: 12 12 12; /* Jet-Light-12 */\n    --on-secondary-rgb-dark: 251 251 251; /* Storm-Dark-15 */\n    --on-primary-hex-dark: #10121a; /*Storm-Dark-1 */\n    --base-subtle-hex: #e9ebf2; /* Storm-Light-3 */\n    --base-subtle-hsl: hsla(227, 26%, 93%, 1); /* Storm-Light-3 */\n    --base-subtle-hex-dark: #30374f; /*Storm-Dark-3 */\n    --base-subtle-hsl-dark: hsla(226, 24%, 25%, 1); /*Storm-Dark-3 */\n    --on-base-hex: #3f496a; /* Storm-Light-12 */\n    --on-base-rgb: rgb(63 73 105); /* Storm-Light-12 */\n    --on-base-hex-dark: #dee2eb; /* Storm-Dark-12 */\n    --on-base-rgb-dark: rgba(222 226 235 1); /* Storm-Dark-12 */\n    --tertiary-hex: #5f6e9f; /* Storm-Light-10 */\n    --tertiary-hex-dark: #d4d8e5; /* Storm-Dark-10 */\n\n    /* Admonition variables */\n\n    --kendo-color-base-border-hex: #3f496a; /* Info Border */\n    --kendo-color-base-border-rgb: rgb(63 73 106/0.14); /* Info Border */\n    --text-color-hex-dark: #ffffff; /* Storm-Light-white */\n    --text-color-rgb-dark: rgb(251 251 251); /* Storm-Light-white */\n    --text-color-hex-light: #10121a; /* Storm-Dark-1 */\n    --text-color-rgb-light: rgb(16 18 26); /* Storm-Dark-1 */\n\n    --success-subtle-hex: #d8efd5; /*Success Green-Light-2 */\n    --success-subtle-rgb: rgb(216 239 213); /* Success Green-Light-2 */\n    --success-subtle-hex-dark: #15470f; /* Success Green-Dark-1 */\n    --success-subtle-rgb-dark: rgba(21 71 15 / 0.5); /* Success Green-Dark-1 */\n\n    --info-subtle-hex: #dde9fe; /* Blue-Light-2 */\n    --info-subtle-rgb: rgb(221 233 254); /* Blue-Light-2 */\n    --info-on-subtle-hex: #001B56; /* Text on subtle info */\n    --info-on-subtle-rgb: rgb(0 27 86); /* Text on subtle info */\n    --kendo-color-info-subtle-active-hex: #114194; /* teal-11 */\n    --kendo-color-info-emphasis-rgb: rgba(17 65 148 / 0.5);\n\n    --warning-subtle-hex: #ffeed4; /* Yellow-Light-2 */\n    --warning-subtle-rgb: rgb(255 238 212); /* Yellow-Light-2 */\n    --warning-subtle-hex-dark: #dba008; /* Yellow-Dark-5 */\n    --warning-subtle-rgb-dark: rgba(219 160 8 / 0.9); /* Yellow-Dark-5 */\n    --on-warning-hex: #0c0c0c; /* Jet-Light-12 */\n    --on-warning-rgb: rgb(12 12 12); /* Jet-Light-12 */\n\n    --error-subtle-hex: #f4c9c9; /* Red-Light-2 */\n    --error-subtle-rgb: rgb(244 201 201); /* Red-Light-2 */\n    --error-subtle-hex-dark: #720100; /* Red-Dark-2 */\n    --error-subtle-rgb-dark: rgba(114 1 0 / 0.5); /* Red-Dark-2 */\n    --on-error-hex: #ffffff; /* Storm-Light-white */\n    --on-error-rgb: rgb(255 255 255); /* Storm-Light-white */\n    --on-error-hex-dark: #10121a; /* Storm-Dark-1 */\n    --on-error-rgb-dark: rgb(16 18 26); /* Storm-Dark-1 */\n}\n\n/* -------------------- */\n/* SMOOTH SCROLLING CSS */\n/* -------------------- */\n\n/* Smoothly scrolls to in-page anchors (e.g. TOC and heading links) instead of jumping instantly */\n@media (prefers-reduced-motion: no-preference) {\n    html {\n        scroll-behavior: smooth;\n    }\n}\n\n/* ---------- */\n/* SEARCH CSS */\n/* ---------- */\n\n\n/* Highlighted search text in dark mode */\n.dark\\:\\[\\\u0026_mark_b\\]\\:text-primary-light mark b:is(.dark *) {\n    color: rgb(var(--primary-rgb));\n}\n\n/* Body text in search results dialog in dark mode */\n.dark [role=\"listbox\"] .text-gray-500 {\n    color: rgb(var(--on-secondary-rgb-dark)) !important;\n}\n\n/* --------------------------- */\n/* BACKGROUND AND SIDE NAV CSS */\n/* --------------------------- */\n\n/* Note: The main background colors are controlled in docs.json via:\n\n  \"background\" : {\n    \"color\" : {\n        \"light\" : \"#f4f5f8\",\n        \"dark\" : \"#10121a\"\n    }\n  },\n/*\n\n/* Removed background from active page in left TOC */\n\n.bg-primary\\/10 {\n    background-color: transparent;\n}\n\n.dark .bg-primary\\/10 {\n    background-color: transparent;\n}\n\n#sidebar-group .group { /* Light mode - Stop hover state from changing vertical padding of TOC items */\n    border: solid 1.5px var(--light-background);\n}\n\n.dark #sidebar-group .group { /* Dark mode - stop hover state from changing vertical padding of TOC items */\n    border: solid 1.5px var(--dark-background);\n}\n\n#sidebar-group .group:hover:not(.text-primary) { /* Light mode */\n    background-color: var(--light-background);\n    border: solid 1.5px var(--info-hex);\n    border-radius: 6px;\n}\n\n#sidebar-group .group.text-primary:hover {\n    background-color: var(--light-background);\n    border: solid 1.5px var(--info-hex);\n    border-radius: 6px;\n    color: rgb(var(--info-rgb));\n}\n\n.dark #sidebar-group .group:hover:not(.text-primary) { /* Dark mode */\n    background-color: var(--dark-background);\n    border: solid 1.5px var(--info-hex-dark);\n    border-radius: 6px;\n    color: #fbfbfb;\n}\n\n.dark #sidebar-group .group.text-primary:hover { /* Dark mode */\n    background-color: var(--dark-background);\n    border: solid 1.5px var(--info-hex-dark);\n    border-radius: 6px;\n    color: rgb(var(--info-rgb-dark));\n}\n\n\n\n/* --------------- */\n/* TOP NAV BAR CSS */\n/* --------------- */\n\n/* Top nav bar currently selected section */\n\n#navbar .text-gray-800 { /* light mode */\n    color: var(--info-hex);\n}\n\n#navbar .dark\\:text-gray-200:is(.dark *) { /* dark mode */\n    color: var(--info-hex-dark);\n}\n\n/* Top nav bar download button */\n\n#topbar-cta-button .bg-primary-dark { /* Button background color */\n    background-color: rgb(var(--primary-rgb));\n}\n\n#topbar-cta-button .text-white { /* Button text color */\n    color: rgb(var(--on-primary-rgb));\n}\n\n#topbar-cta-button svg path { /* Button chevron color */\n    stroke: rgb(var(--on-primary-rgb));\n}\n\n.dark #topbar-cta-button .bg-primary-dark { /* Button background color */\n    background-color: rgb(var(--info-rgb-dark));\n}\n\n.dark #topbar-cta-button .text-white { /* Button text color */\n    color: rgb(var(--on-primary-rgb));\n}\n\n.dark #topbar-cta-button svg path { /* Button chevron color */\n    stroke: rgb(var(--on-primary-rgb));\n}\n\n/* Underlines for top nav bar currently selected section */\n\n#navbar a.h-full .bg-primary { /* light mode */\n    background-color: var(--info-hex);\n}\n   \n#navbar a.h-full .dark\\:bg-primary-light:is(.dark *) { /* dark mode */\n    background-color: var(--info-hex-dark);\n}\n\n/* Search bar backgrounds */\n\n#navbar .bg-background-light {\n    background-color: rgb(251 251 251);\n}\n\n.dark #navbar .dark\\:bg-background-dark {\n    background-color: rgb(32 37 53)\n}\n\n/* -------- */\n/* TEXT CSS */\n/* -------- */\n\n/* Header font changes - H1, H2 are Manrope, while H3 and below are Inter */\n\n@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700\u0026display=swap');\n   \n   h1, h2 {\n     font-family: 'Manrope', sans-serif !important;\n   }\n   \n   h3, h4, h5 {\n     font-family: 'Inter', 'Inter Fallback', sans-serif !important;\n   }\n\n   h3.font-semibold, h4.font-semibold {\n    font-weight: 500;\n   }\n\n/* Changed color of primary text specifically */\n\n.text-primary {\n    color: var(--info-hex);\n}\n\n.dark\\:text-primary-light:is(.dark *) {\n    color: var(--info-hex-dark);\n}\n\n/* Simplified link styles for prose links */\n.prose a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)):not(.not-prose) {\n    color: var(--info-hex) !important;\n    text-decoration: underline;\n    text-decoration-color: var(--info-hex);\n    text-decoration-thickness: 1px;\n    text-underline-offset: 4px;\n}\n\n.prose a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)):not(.not-prose):hover {\n    text-decoration-thickness: 2px;\n}\n\n\n/* Fix underline offset in admonitions*/\n.prose [data-component-part=\"callout-content\"] a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)):not(.not-prose) {\n    text-underline-offset: 3px;\n}\n\n/* Dark mode styles */\n.dark .prose a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)):not(.not-prose) {\n    color: var(--info-hex-dark) !important;\n    text-decoration: underline;\n    text-decoration-color: var(--info-hex-dark);\n    text-decoration-thickness: 1px;\n    text-underline-offset: 4px;\n}\n\n/* Fix underline offset in admonitions */\n.dark .prose [data-component-part=\"callout-content\"] a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)):not(.not-prose) {\n    text-underline-offset: 3px;\n}\n\n.dark .prose a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)):not(.not-prose):hover {\n    color: var(--info-hex-dark) !important;\n    text-decoration-thickness: 2px;\n}\n\n/* Remove underlines from links that wrap inline icon badges (e.g., Anaconda Notebooks badge) */\n.prose a:has(span.inline_icon) {\n    text-decoration: none;\n    border-bottom: none !important;\n}\n\n/* Remove underlines from code inside links */\n.prose a code {\n    text-decoration: none;\n}\n\n/*Text color changes*/\n\n.prose { /* Light mode body text */\n    color: rgb(var(--on-primary-rgb));\n}\n\n.dark .prose { /* Dark mode body text */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.text-gray-400, .text-gray-500, .text-gray-700 { /* Light mode sidebar page text and chevrons, light mode icon, On this page text */\n    color: rgb(var(--on-primary-rgb));\n}\n\n#chat-content .text-gray-500 { /* Excludes assistant buttons from above .text-gray-500 color change */\n    color: rgb(var(--gray-500));\n}\n\n.prose :where(ol\u003eli):not(:where([class~=not-prose],[class~=not-prose] *))::marker { /* Light mode list numbers */\n    color: rgb(var(--on-primary-rgb));\n}\n\n.dark\\:text-gray-200:is(.dark *) { /* Dark mode accordion text */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.dark\\:text-gray-300:is(.dark *) { /* Dark mode copy text button */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.dark\\:text-gray-400:is(.dark *) { /* Dark mode body copy */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.dark .prose :where(ol\u003eli):not(:where([class~=not-prose],[class~=not-prose] *))::marker { /* Dark mode list numbers */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.prose ul\u003eli:before {\n    background-color: rgb(var(--on-primary-rgb));\n}\n.dark .prose ul\u003eli:before {\n    background-color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.dark\\:text-white\\/50:is(.dark *) { /* Dark mode search text, Copy page chevron */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.dark\\:text-gray-600:is(.dark *) { /* Dark mode sidebar chevrons, Copy page chevron */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n.prose a strong:is(.dark *) { /* Dark mode bold link text */\n    color: var(--primary-hex-dark);\n}\n\n.dark\\:group-hover\\:text-gray-300:is(.dark *) { /* Dark mode button */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n#footer .dark\\:text-white\\/50:is(.dark *) { /* Dark mode footer link text */\n    color: rgb(var(--on-secondary-rgb-dark));\n}\n\n#footer .dark\\:bg-gray-600:is(.dark *) { /* Dark mode footer icon fill */\n    background-color: rgb(var(--on-secondary-rgb-dark));\n}\n\n#footer .text-gray-950\\/50 { /* Light mode footer link text */\n    color: rgb(var(--on-primary-rgb));\n}\n\n#footer .bg-gray-500 { /* Light mode footer icon fill */\n    background-color: rgb(var(--on-primary-rgb));\n}\n\n/* -------------- */\n/* ADMONITION CSS */\n/* -------------- */\n\n/* Tip/check admonition coloring */\n\n[data-callout-type=\"tip\"],\n[data-callout-type=\"check\"] {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: var(--success-subtle-rgb);\n}\n\n[data-callout-type=\"tip\"] [data-component-part=\"callout-icon\"] svg,\n[data-callout-type=\"check\"] [data-component-part=\"callout-icon\"] svg {\n    color: var(--text-color-rgb-light);\n}\n\n[data-callout-type=\"tip\"] [data-component-part=\"callout-content\"],\n[data-callout-type=\"check\"] [data-component-part=\"callout-content\"] {\n    color: var(--text-color-rgb-light);\n}\n\n.prose [data-callout-type=\"tip\"] ul\u003eli:before,\n.prose [data-callout-type=\"check\"] ul\u003eli:before {\n    background-color: var(--text-color-rgb-light);\n}\n\n[data-callout-type=\"tip\"] :where(thead th),\n[data-callout-type=\"check\"] :where(thead th) {\n    color: var(--text-color-rgb-light);\n}\n\n[data-callout-type=\"tip\"] :where(thead),\n[data-callout-type=\"tip\"] :where(tr),\n[data-callout-type=\"check\"] :where(thead),\n[data-callout-type=\"check\"] :where(tr) {\n    border-color: var(--text-color-rgb-light);\n    color: var(--text-color-rgb-light);\n}\n\nhtml.dark [data-callout-type=\"tip\"],\nhtml.dark [data-callout-type=\"check\"] {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: var(--success-subtle-rgb-dark);\n}\n\nhtml.dark [data-callout-type=\"tip\"] [data-component-part=\"callout-icon\"] svg,\nhtml.dark [data-callout-type=\"check\"] [data-component-part=\"callout-icon\"] svg {\n    color: var(--text-color-rgb-dark);\n}\n\nhtml.dark [data-callout-type=\"tip\"] [data-component-part=\"callout-content\"],\nhtml.dark [data-callout-type=\"check\"] [data-component-part=\"callout-content\"] {\n    color: var(--text-color-rgb-dark);\n}\n\nhtml.dark .prose [data-callout-type=\"tip\"] ul\u003eli:before,\nhtml.dark .prose [data-callout-type=\"check\"] ul\u003eli:before {\n    background-color: var(--text-color-rgb-dark);\n}\n\nhtml.dark [data-callout-type=\"tip\"] :where(thead th),\nhtml.dark [data-callout-type=\"check\"] :where(thead th) {\n    color: var(--text-color-rgb-dark);\n}\n\nhtml.dark [data-callout-type=\"tip\"] :where(thead),\nhtml.dark [data-callout-type=\"tip\"] :where(tr),\nhtml.dark [data-callout-type=\"check\"] :where(thead),\nhtml.dark [data-callout-type=\"check\"] :where(tr) {\n    border-color: var(--text-color-rgb-dark);\n    color: var(--text-color-rgb-dark);\n}\n\n/* Note admonition coloring */\n\n[data-callout-type=\"note\"] {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: var(--info-subtle-rgb);\n}\n\n[data-callout-type=\"note\"] [data-component-part=\"callout-icon\"] svg {\n    color: var(--info-on-subtle-rgb);\n}\n\n[data-callout-type=\"note\"] [data-component-part=\"callout-content\"] {\n    color: var(--info-on-subtle-rgb);\n}\n\n.prose [data-callout-type=\"note\"] ul\u003eli:before {\n    background-color: var(--info-on-subtle-rgb);\n}\n\n[data-callout-type=\"note\"] :where(thead th) {\n    color: var(--info-on-subtle-rgb);\n}\n\n[data-callout-type=\"note\"] :where(thead),\n[data-callout-type=\"note\"] :where(tr) {\n    border-color: var(--info-on-subtle-rgb);\n    color: var(--info-on-subtle-rgb);\n}\n\nhtml.dark [data-callout-type=\"note\"] {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: var(--kendo-color-info-emphasis-rgb);\n}\n\nhtml.dark [data-callout-type=\"note\"] [data-component-part=\"callout-icon\"] svg {\n    color: var(--info-subtle-rgb);\n}\n\nhtml.dark [data-callout-type=\"note\"] [data-component-part=\"callout-content\"] {\n    color: var(--info-subtle-rgb);\n}\n\nhtml.dark .prose [data-callout-type=\"note\"] ul\u003eli:before {\n    background-color: var(--info-subtle-rgb);\n}\n\nhtml.dark [data-callout-type=\"note\"] :where(thead th) {\n    color: var(--info-subtle-rgb);\n}\n\nhtml.dark [data-callout-type=\"note\"] :where(thead),\nhtml.dark [data-callout-type=\"note\"] :where(tr){\n    border-color: var(--info-subtle-rgb);\n    color: var(--info-subtle-rgb);\n}\n\n/* Warning admonition coloring */\n\n[data-callout-type=\"warning\"] {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: var(--warning-subtle-rgb);\n}\n\n[data-callout-type=\"warning\"] [data-component-part=\"callout-icon\"] svg {\n    color: var(--on-warning-rgb);\n}\n\n[data-callout-type=\"warning\"] [data-component-part=\"callout-content\"] {\n    color: var(--on-warning-rgb);\n}\n\n.prose [data-callout-type=\"warning\"] ul\u003eli:before {\n    background-color: var(--on-warning-rgb);\n}\n\n.prose [data-callout-type=\"warning\"] :where(ol\u003eli)::marker {\n    color: var(--on-warning-rgb);\n}\n\n[data-callout-type=\"warning\"] :where(thead th) {\n    color: var(--on-warning-rgb);\n}\n\n[data-callout-type=\"warning\"] :where(thead),\n[data-callout-type=\"warning\"] :where(tr) {\n    border-color: var(--on-warning-rgb);\n    color: var(--on-warning-rgb);\n}\n\nhtml.dark [data-callout-type=\"warning\"] {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: var(--warning-subtle-rgb-dark);\n}\n\nhtml.dark [data-callout-type=\"warning\"] [data-component-part=\"callout-icon\"] svg {\n    color: var(--text-color-rgb-light);\n}\n\nhtml.dark [data-callout-type=\"warning\"] [data-component-part=\"callout-content\"] {\n    color: var(--text-color-rgb-light);\n}\n\nhtml.dark .prose [data-callout-type=\"warning\"] ul\u003eli:before {\n    background-color: var(--text-color-rgb-light);\n}\n\nhtml.dark .prose [data-callout-type=\"warning\"] :where(ol\u003eli)::marker {\n    color: var(--text-color-rgb-light);\n}\n\nhtml.dark [data-callout-type=\"warning\"] :where(thead th) {\n    color: var(--text-color-rgb-light);\n}\n\nhtml.dark [data-callout-type=\"warning\"] :where(thead),\nhtml.dark [data-callout-type=\"warning\"] :where(tr){\n    border-color: var(--text-color-rgb-light);\n    color: var(--text-color-rgb-light);\n}\n\n/* Light mode — ensure warning links match body text */\n[data-callout-type=\"warning\"] .prose a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)) {\n    color: currentColor !important;\n    text-decoration-color: currentColor;\n    border-bottom: 1px solid currentColor;\n}\n\n[data-callout-type=\"warning\"] .prose a:not(.card):not([class*=\"-ml-10\"]):hover {\n    border-bottom-width: 2px;\n}\n\n.dark [data-callout-type=\"warning\"] .prose a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)) {\n    color: currentColor !important;\n    text-decoration-color: currentColor;\n    border-bottom: 1px solid currentColor;\n}\n\n.dark [data-callout-type=\"warning\"] .prose a:not(.card):not([class*=\"-ml-10\"]):not(:has(code)):hover {\n    border-bottom-width: 2px;\n}\n\n/* Yellow badge accessibility */\nspan[data-badge=\"true\"][data-color=\"yellow\"] {\n    background-color: var(--warning-subtle-hex) !important;\n    border-color: var(--on-warning-hex) !important;\n    color: var(--on-warning-hex) !important;\n    --color-bg: var(--warning-subtle-hex) !important;\n    --color-text: var(--on-warning-hex) !important;\n}\nspan[data-badge=\"true\"][data-color=\"yellow\"] svg {\n    color: var(--on-warning-hex) !important;\n    fill: var(--on-warning-hex) !important;\n}\nhtml.dark span[data-badge=\"true\"][data-color=\"yellow\"] {\n    background-color: rgba(219, 160, 8, 0.9) !important;\n    border-color: #0c0c0c !important;\n    color: #0c0c0c !important;\n    --color-bg: rgba(219, 160, 8, 0.9) !important;\n    --color-text: #0c0c0c !important;\n}\nhtml.dark span[data-badge=\"true\"][data-color=\"yellow\"] svg {\n    color: #0c0c0c !important;\n    fill: #0c0c0c !important;\n}\n\n/* Danger admonition coloring */\n\n.danger-admonition {\n    border: 1px solid var(--kendo-color-base-border-rgb);\n    background-color: var(--error-subtle-rgb);\n  }\n\n.danger-admonition .prose,\n.danger-admonition .prose strong {\n    color: var(--on-error-rgb-dark);\n}\n\n.danger-admonition ul\u003eli:before {\n    background-color: var(--on-error-rgb-dark);\n}\n\n.danger-admonition .prose :where(thead th),\n.danger-admonition .prose {\n    color: var(--on-error-rgb-dark);\n}\n\n.danger-admonition .prose thead,\n.danger-admonition .prose tr {\n    border-color: var(--on-error-rgb-dark);\n}\n\n.danger-admonition svg {\n    fill: var(--on-error-rgb-dark);\n}\n\n/* Danger admonition links match text color */\n[data-callout-type=\"danger\"] .prose a:not(.card):not([class*=\"-ml-10\"]) {\n    color: var(--on-warning-rgb) !important;\n    border-bottom: 1px solid var(--on-warning-rgb);\n}\n\n[data-callout-type=\"danger\"] .prose a:not(.card):not([class*=\"-ml-10\"]):hover {\n    border-bottom: 2px solid var(--on-warning-rgb);\n}\n\n.dark\\:danger-admonition:is(.dark *) {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: var(--error-subtle-rgb-dark);\n  }\n\n.dark\\:danger-admonition:is(.dark *) .prose:is(.dark *) :where(thead th),\n.dark\\:danger-admonition:is(.dark *) .prose:is(.dark *),\n.dark\\:danger-admonition:is(.dark *) .prose:is(.dark *) strong:is(.dark *) {\n    color: var(--on-error-rgb);\n}\n\n.dark\\:danger-admonition:is(.dark *) .prose thead:is(.dark *),\n.dark\\:danger-admonition:is(.dark *) .prose tr:is(.dark *) {\n    border-color: var(--on-error-rgb);\n}\n\n.dark\\:danger-admonition:is(.dark *) ul\u003eli:before {\n    background-color: var(--on-error-rgb);\n}\n\n.dark\\:danger-admonition:is(.dark *) svg {\n    fill: var(--on-error-rgb);\n}\n\n/* Dark mode warning admonition links */\n.dark [data-callout-type=\"danger\"] .prose a:not(.card):not([class*=\"-ml-10\"]) {\n    color: var(--on-error-rgb) !important;\n    border-bottom: 1px solid var(--on-error-rgb);\n}\n\n.dark [data-callout-type=\"danger\"] .prose a:not(.card):not([class*=\"-ml-10\"]):hover {\n    border-bottom: 2px solid var(--on-error-rgb);\n}\n\n/* Beginner admonition coloring */\n\n.beginner-admonition {\n    border: 1px solid var(--kendo-color-base-border-rgb);\n    background-color: rgb(209, 242, 255);\n  }\n\n.beginner-admonition .prose,\n.beginner-admonition .prose strong {\n    color: var(--text-color-rgb-light);\n}\n\n.beginner-admonition ul\u003eli:before {\n    background-color: var(--text-color-rgb-light);\n}\n\n.beginner-admonition .prose :where(thead th),\n.beginner-admonition .prose {\n    color: var(--text-color-rgb-light);\n}\n\n.beginner-admonition .prose thead,\n.beginner-admonition .prose tr {\n    border-color: var(--text-color-rgb-light);\n}\n\n.beginner-admonition svg {\n    fill: var(--text-color-rgb-light);\n}\n\n.dark\\:beginner-admonition:is(.dark *) {\n    border-color: rgba(251 251 251 / 0.61);\n    background-color: rgb(9 17 3);\n  }\n\n.dark\\:beginner-admonition:is(.dark *) .prose:is(.dark *) :where(thead th),\n.dark\\:beginner-admonition:is(.dark *) .prose:is(.dark *),\n.dark\\:beginner-admonition:is(.dark *) .prose:is(.dark *) strong:is(.dark *) {\n    color: var(--text-color-rgb-dark);\n}\n\n.dark\\:beginner-admonition:is(.dark *) ul\u003eli:before {\n    background-color: var(--text-color-rgb-dark);\n}\n\n.dark\\:beginner-admonition:is(.dark *) .prose thead:is(.dark *),\n.dark\\:beginner-admonition:is(.dark *) .prose tr:is(.dark *) {\n    border-color: var(--text-color-rgb-dark);\n}\n\n.dark\\:beginner-admonition:is(.dark *) svg {\n    fill: var(--text-color-rgb-dark);\n}\n\n/* Advanced admonition coloring */\n\n.advanced-admonition {\n    border: 1px solid var(--kendo-color-base-border-rgb);\n    background-color: rgb(212 216 229);\n  }\n\n.advanced-admonition .prose,\n.advanced-admonition .prose strong {\n    color: var(--text-color-rgb-light);\n}\n\n.advanced-admonition ul\u003eli:before {\n    background-color: var(--text-color-rgb-light);\n}\n\n.advanced-admonition .prose :where(thead th),\n.advanced-admonition .prose {\n    color: var(--text-color-rgb-light);\n}\n\n.advanced-admonition .prose thead,\n.advanced-admonition .prose tr {\n    border-color: var(--text-color-rgb-light);\n}\n\n.advanced-admonition svg {\n    fill: var(--text-color-rgb-light);\n}\n\n.dark\\:advanced-admonition:is(.dark *) {\n    border-color: var(--kendo-color-base-border-rgb);\n    background-color: rgb(48 55 79);\n  }\n\n.dark\\:advanced-admonition:is(.dark *) .prose:is(.dark *) :where(thead th),\n.dark\\:advanced-admonition:is(.dark *) .prose:is(.dark *),\n.dark\\:advanced-admonition:is(.dark *) .prose:is(.dark *) strong:is(.dark *) {\n    color: var(--text-color-rgb-dark);\n}\n\n.dark\\:advanced-admonition:is(.dark *) ul\u003eli:before {\n    background-color: var(--text-color-rgb-dark);\n}\n\n.dark\\:advanced-admonition:is(.dark *) .prose thead:is(.dark *),\n.dark\\:advanced-admonition:is(.dark *) .prose tr:is(.dark *) {\n    border-color: var(--text-color-rgb-dark);\n}\n\n.dark\\:advanced-admonition:is(.dark *) svg {\n    fill: var(--text-color-rgb-dark);\n}\n\n/* Admonition horizontal rule changes */\n\n.prose :where([data-callout-type=\"tip\"] hr, [data-callout-type=\"check\"] hr):not(:where([class~=not-prose],[class~=not-prose] *)),\n.prose :where([data-callout-type=\"note\"] hr):not(:where([class~=not-prose],[class~=not-prose] *)),\n.prose :where([data-callout-type=\"warning\"] hr, [data-callout-type=\"beginner\"] hr):not(:where([class~=not-prose],[class~=not-prose] *)),\n.prose :where([data-callout-type=\"danger\"] hr):not(:where([class~=not-prose],[class~=not-prose] *)),\n.prose :where([data-callout-type=\"advanced\"] hr):not(:where([class~=not-prose],[class~=not-prose] *)),\n.prose :where([data-callout-type=\"learnmore\"] hr):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    margin-top: 1em;\n    margin-bottom: 1em;\n    border-color: var(--text-color-rgb-light);\n}\n\n.dark .prose :where([data-callout-type=\"tip\"] hr, [data-callout-type=\"check\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)),\n.dark .prose :where([data-callout-type=\"note\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)),\n.dark .prose :where([data-callout-type=\"warning\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)),\n.dark .prose :where([data-callout-type=\"danger\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)),\n.dark .prose :where([data-callout-type=\"advanced\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)),\n.dark .prose :where([data-callout-type=\"beginner\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)),\n.dark .prose :where([data-callout-type=\"learnmore\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    border-color: var(--text-color-rgb-dark);\n}\n\n.dark .prose :where([data-callout-type=\"warning\"] hr):is(.dark *):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    border-color: var(--text-color-rgb-light);\n}\n\n.prose :where(\n    [data-callout-type=\"note\"] p,\n    [data-callout-type=\"tip\"] p,\n    [data-callout-type=\"warning\"] p,\n    [data-callout-type=\"danger\"] p,\n    [data-callout-type=\"check\"] p,\n    [data-callout-type=\"beginner\"] p,\n    [data-callout-type=\"advanced\"] p,\n    [data-callout-type=\"learnmore\"] p\n  ):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    margin-bottom: 0em;\n  }\n\n/* ---------------------------- */\n/* ACCORDION AND CODE BLOCK CSS */\n/* ---------------------------- */\n\n/* Fixing code copy icon SVG fill color for code blocks inside admonitions */\n\n.callout .code-group svg,\n.callout .code-block svg {\n    fill: none;\n}\n\n/* Accordion and code block colors */\n\n.callout .code-group {\n    background-color: rgb(251 251 251);\n}\n\n.dark .callout .code-group {\n    background-color: rgb(32 37 53);\n}\n\n.accordion.bg-background-light {\n    background-color: rgb(251 251 251);\n}\n\n[data-component-part=\"code-group-tab-bar\"] .bg-primary {\n    background-color: rgb(var(--info-rgb));\n}\n\n.group:hover .group-hover\\:text-primary {\n    color: var(--info-hover-rgb);\n}\n\n.dark [data-component-part=\"code-group-tab-bar\"] .bg-primary {\n    background-color: var(--info-hext-rgb-dark);\n}\n\n.dark .group:hover .group-hover\\:text-primary {\n    color: var(--info-hover-rgb-dark);\n}\n\n.dark\\:bg-codeblock:is(.dark *) {\n    background-color: hsla(226, 25%, 17%, 1);\n}\n\n.border-standard:is(.dark *) {\n    border-color: hsla(222, 5%, 40%, 0.25);\n}\n\n.dark\\:border-gray-800\\/50:is(.dark *) {\n    border-color: hsla(222, 5%, 40%, 0.25);\n}\n\n.hover\\:dark\\:bg-gray-800:is(.dark *):hover {\n    background-color: rgba(222, 228, 224, 0.05)\n}\n\n.active\\:scrollbar-thumb-white\\/25 {\n    --scrollbar-thumb-active: hsla(0,0%,100%,.4)!important\n}\n\n.hover\\:scrollbar-thumb-white\\/25 {\n    --scrollbar-thumb-hover: hsla(0,0%,100%,.4)!important\n}\n\n.scrollbar-thumb-white\\/20 {\n    --scrollbar-thumb: hsla(0,0%,100%,.3)!important\n}\n\n.hover\\:bg-gray-100:hover {\n    background-color: rgba(247, 248, 249, 1);\n}\n\n/*Ensure code problem feedback popup is not transparent*/\n\n.text-popover-foreground.dark\\:bg-codeblock:is(.dark *) {\n    background-color: rgba(35,35,36,var(--tw-bg-opacity))\n}\n\n/* Code formatting color changes */\n\n/* Dark mode warning — inline code matches standard dark mode inline code style */\nhtml.dark [data-callout-type=\"warning\"] [data-component-part=\"callout-content\"] :not(pre)\u003ecode {\n    background-color: #1e2030 !important;\n    color: #dee2eb !important;\n    -webkit-text-fill-color: #dee2eb;\n}\n\n/* Dark mode warning — code inside a link gets green */\n.dark [data-callout-type=\"warning\"] .prose a:has(code) {\n    color: var(--info-hex-dark) !important;\n    text-decoration-color: var(--info-hex-dark);\n    border-bottom: none;\n}\n\n:not(pre)\u003ecode { /* Inline code formatting */\n    background-color: hsla(210, 14%, 97%, 1); /* kendo-color-light-subtle grey-10 */\n    border: 1px solid hsla(222, 5%, 40%, 0.25);\n}\n\n.dark :not(pre)\u003ecode {\n    background-color: #1e2030;\n    border-color: hsla(222, 5%, 40%, 0.25);\n}\n\n.prose :where(code):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    color: #3f496a;\n}\n\n.dark .prose :where(code):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    color: #dee2eb;\n}\n\n/* Text link styling changes */\n\n.prose a:has(code) {\n    color: var(--info-hex) !important;\n    border-bottom: none;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n    text-decoration-color: var(--info-hex);\n    text-decoration-thickness: 1px;\n}\n\n.prose a:has(code):hover {\n    text-decoration-thickness: 2px;\n}\n\n.dark .prose a:has(code) {\n    color: var(--info-hex-dark) !important;\n    border-bottom: none;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n    text-decoration-color: var(--info-hex-dark);\n    text-decoration-thickness: 1px;\n}\n\n.dark .prose a:has(code):hover {\n    text-decoration-thickness: 2px;\n}\n\n/* Assistant dark mode button link hover color */\n\n.dark\\:hover\\:text-primary:hover:is(.dark *) {\n    color: var(--info-hex-dark) !important;\n}\n\n/* Code snippet feedback form */\n\n.code-snippet-feedback-form-submit-button .text-white { /* Light text in light mode submit button */\n    color: rgb(251 251 251);\n}\n\nhtml.dark .code-snippet-feedback-form-submit-button .dark\\:text-white { /* Dark text in dark mode submit button */\n    color: rgb(12 12 12);\n}\n\n[data-testid=\"copy-code-button\"]:hover svg,\n[data-testid=\"code-snippet-feedback-button\"]:hover svg,\n[data-testid=\"ask-ai-code-block-button\"]:hover svg { /* Light Mode */\n    color: rgba(32 37 53 0.04) !important;\n}\n\n.dark [data-testid=\"copy-code-button\"]:hover svg,\n.dark [data-testid=\"code-snippet-feedback-button\"]:hover svg,\n.dark [data-testid=\"ask-ai-code-block-button\"]:hover svg { /* Dark Mode */\n    color: rgba(251 251 251 0.04) !important;\n}\n\n.code-block-background {\n    background-color: #fbfbfb;\n    border: 1px solid rgba(16 18 26 / 0.1);\n}\n\nhtml.dark .code-block-background {\n    background-color: #10121a;\n    border: 1px solid rgba(251 251 251 / 0.25)\n}\n\n/* Changed light mode hover slugs on code block buttons to blue with white text.\nDark mode slugs are controlled by the docs.json primary color and the regular doc \ntemplate, so dark mode is excluded from these changes */\n\nhtml:not(.dark) .code-block .text-xs.bg-primary-dark,\nhtml:not(.dark) .code-group .text-xs.bg-primary-dark {\n    background-color: rgb(var(--info-rgb));\n}\n\nhtml:not(.dark) .code-block .text-white,\nhtml:not(.dark) .code-group .text-white,\nhtml:not(.dark) .code-block .text-tooltip-foreground,\nhtml:not(.dark) .code-group .text-tooltip-foreground {\n    color: rgb(251 251 251);\n}\n\n/* Code text right padding to avoid long code\nlines bumping the edge of the codeblock */\n\npre code {\n    padding-right: 20px;\n}\n\n/* Code block line highlighting color */\n\n/* Ensure highlight covers entire code block */\n/* Tied to padding rule: .\\[\\\u0026_pre\\\u003ecode\\]\\:pr-\\[3rem\\] pre\u003ecode */\n/* If you update the margin-right and width of this rule, update that rule as well */\n.code-block .shiki .line-highlight {\n    margin-right: -6.8rem !important;\n    width: calc(100% + 6.8rem) !important;\n    /* Ensure highlight doesn't cause overflow issues */\n    max-width: none;\n}\n\n/* Fix code block code copy and code problem buttons overlap issue */\n/* Tied to .code-block .shiki .line-highlight */\n/* If you update the padding-right of this rule, update that rule as well*/\n.\\[\\\u0026_pre\\\u003ecode\\]\\:pr-\\[3rem\\] pre\u003ecode {\n    padding-right: 6.8rem;\n}\n\n.dark [data-component-part=code-block-root]:not(.has-line-numbers) .line-highlight { /* Change dark mode highlight to primary blue */\n    background: rgba(8 202 74 / .16) !important;\n}\n\n.dark [data-component-part=code-block-root]:not(.has-line-numbers) .line-highlight:after, .dark [data-component-part=code-block-root]:not(.has-line-numbers) .line-highlight:before { /* Change dark mode highlight to primary blue */\n    background: rgba(8 202 74 / .16) !important;\n}\n\n.dark [data-component-part=code-block-root]:not(.has-line-numbers) .line-highlight:before { /* Change dark mode highlight border to primary blue */\n    border-left: 1px solid rgba(8 202 74 / 1) !important;\n}\n\n/* Add spacing above accordions that directly follow tabs */\n.tabs + .accordion.mb-3 {\n  margin-top: .75rem;\n}\n\n/* Add spacing above tabs inside admonitions */\n.callout .tabs {\n  margin-top: .75rem;\n}\n\n/* Code group rounded radius removal */\n\n.code-group .rounded-xt {\n    border-radius: 0;\n}\n\n/* -------- */\n/* CARD CSS */\n/* -------- */\n\n/* Outlines for cards on hover */\n\n@layer utilities {\n    .card:hover {\n        border-color: rgb(29 108 247) !important;\n    }\n\n    html.dark .card:hover {\n        border-color: rgb(150 247 120) !important;\n    }\n}\n\n/* Card background */\n\n.card {\n    background-color: rgb(251 251 251);\n}\n\n.dark .card {\n    background-color: rgb(32 37 53);\n}\n\n/* For selected cards (not hovered) */\n.dark .selector .card-group a.card.border-primary {\n    border-color: rgb(var(--info-rgb-dark)) !important;\n}\n\n/* For hover state */\n.dark .selector .card-group a.card:hover {\n    border-color: rgb(var(--info-rgb-dark)) !important;\n}\n\n.card .mint-text-gray-800 {\n    color: var(--on-primary-rgb);\n}\n\n.card .mint-text-gray-600 {\n    color: var(--on-primary-rgb);\n}\n\n.dark .card .mint-text-white {\n    color: var(--on-secondary-rgb-dark);\n}\n\n.card .dark\\:mint-text-gray-400:is(.dark *) {\n    color: var(--on-secondary-rgb-dark);\n}\n\n/* -------- */\n/* ICON CSS */\n/* -------- */\n\n/* Custom icon inline flex display */\n\n.inline_icon {\n  display: inline-flex;\n  vertical-align: text-bottom;\n}\n\n/* FontAwesome icon colors */\n\nsvg.bg-primary {\n    background-color: currentColor;\n}\n\nsvg.dark\\:bg-primary-light:is(.dark *) {\n    background-color: currentColor;\n}\n\n/* ------- */\n/* TAB CSS */\n/* ------- */\n\n.tabs {\n    border: 1px solid hsla(222, 5%, 40%, 0.25);\n    padding: 0px 10px 10px 10px;\n    border-radius: 6px;\n}\n\n/* Tabs inside admonitions — light mode */\n.callout .tabs,\n[data-callout-type] .tabs {\n    background-color: var(--light-background);\n}\n\n/* Tabs inside admonitions — dark mode */\nhtml.dark .callout .tabs,\nhtml.dark [data-callout-type] .tabs {\n    background-color: var(--dark-background);\n}\n\nhtml.dark .tabs .dark\\:prose-dark {\n    color: rgb(251 251 251);\n}\n\n/* ------------------- */\n/* FEEDBACK BUTTON CSS */\n/* ------------------- */\n\n/* Feedback button hover/active status changes */\n\n/* Light mode */\n\n/* Thumbs up button while being clicked */\n.flex.flex-row.gap-3.items-center button:first-child:active {\n    color: #15470F !important; /* Text color for \"Yes\" */\n    background-color: #A0D79A !important;\n    border-color: #A0D79A !important;\n}\n  \n.flex.flex-row.gap-3.items-center button:first-child:active svg {\n    fill: #15470F !important; /* Fill for thumbs up icon */\n}\n  \n/* Thumbs down button while being clicked */\n.flex.flex-row.gap-3.items-center button:last-child:active {\n    color: #570000 !important; /* Text for \"No\" */\n    background-color: #E98A8A !important;\n    border-color: #E98A8A !important;\n}\n  \n.flex.flex-row.gap-3.items-center button:last-child:active svg {\n    fill: #570000 !important; /* Fill for thumbs down icon */\n}\n\n/* Cancel button hover */\n.leading-6 .contextual-feedback-form button:first-child:hover {\n    border-color: rgb(0, 0, 0);\n}\n\n/* Cancel button while being clicked */\n.leading-6 .contextual-feedback-form button:first-child:active {\n    color: rgb(255, 255, 255);\n    background-color: rgb(0, 0, 0);\n    border-color: rgb(0, 0, 0);\n}\n\n/* Dark mode */\n  \n/* Thumbs up button while being clicked */\nhtml.dark .flex.flex-row.gap-3.items-center button:first-child:active {\n    color: #131314 !important; /* Text color for \"Yes\" */\n    background-color: #75C56C !important;\n    border-color: #75C56C !important;\n}\n  \nhtml.dark .flex.flex-row.gap-3.items-center button:first-child:active svg {\n    fill: #131314 !important; /* Fill for thumbs up icon */\n}\n  \n/* Thumbs down button while being clicked */\nhtml.dark .flex.flex-row.gap-3.items-center button:last-child:active {\n    color: #FBC8C3 !important; /* Text color for \"No\" */\n    background-color: #940100 !important;\n    border-color: #940100 !important;\n}\n  \nhtml.dark .flex.flex-row.gap-3.items-center button:last-child:active svg {\n    fill: #FBC8C3 !important; /* Fill for thumbs down icon */\n}\n\n/* Cancel button hover */\nhtml.dark .leading-6 .contextual-feedback-form button:first-child:hover {\n    border-color: rgb(255,255,255);\n}\n\n/* Cancel button while being clicked */\nhtml.dark .leading-6 .contextual-feedback-form button:first-child:active {\n    color: rgb(0, 0, 0);\n    background-color: rgb(255, 255, 255);\n    border-color: rgb(255, 255, 255);\n}\n\n/*Submit button hover */\nhtml.dark .leading-6 .contextual-feedback-form button:last-child:hover {\n    background-color: rgb(var(--gray-300));\n}\n\n/* ------------ */\n/* COMMENTS CSS */\n/* ------------ */\n\n.code-block:has(+ div[data-callout-type=\"comments\"]),\n.code-group:has(+ div[data-callout-type=\"comments\"]) {\n    margin-bottom: 0 !important;\n}\n\ndiv:has(.code-block):has(+ div[data-callout-type=\"comments\"]) .code-block,\ndiv:has(.code-group):has(+ div[data-callout-type=\"comments\"]) .code-group {\n    margin-bottom: 0 !important;\n}\n\ndiv[data-callout-type=\"comments\"].mint-my-4 {\n    margin-top: 0px;\n}\n\ndiv[data-callout-type=\"comments\"].mint-border {\n    border-width: 0px 1px 1px 1px;\n}\n\n.code-group + [data-callout-type=\"comments\"].mint-bg-zinc-50\\/50 {\n  background-color: transparent;\n}\n\n.code-group + [data-callout-type=\"comments\"].dark\\:mint-bg-zinc-500\\/10:is(.dark *) {\n    background-color: rgb(35,35,36);\n}\n\n/* -------------------------- */\n/* TROUBLESHOOT COMPONENT CSS */\n/* -------------------------- */\n\n.troubleshoot-admonition {\n  border: 1px solid rgba(96, 99, 106, 0.16);\n  background-color: rgba(247, 248, 249, .5);\n}\n\n.troubleshoot-admonition .prose,\n.troubleshoot-admonition .prose strong {\n  color: rgba(24, 24, 27, 1);\n}\n\n.troubleshoot-admonition .prose thead,\n.troubleshoot-admonition .prose tr {\n  border-color: rgba(96, 99, 106, 0.5);\n}\n\n.troubleshoot-admonition svg {\n  fill: rgba(24, 24, 27, 1);\n}\n\n.troubleshoot-admonition .bg-amber-50\\/50 svg {\n    fill: none;\n}\n\n.troubleshoot-admonition .code-group svg,\n.troubleshoot-admonition .code-block svg {\n    fill: none;\n}\n\n.dark\\:troubleshoot-admonition:is(.dark *) {\n  border-color: rgba(113, 113, 122, .3);\n  background-color: rgba(113, 113, 122, .1);\n}\n\n.dark\\:troubleshoot-admonition:is(.dark *) .prose:is(.dark *),\n.dark\\:troubleshoot-admonition:is(.dark *) .prose:is(.dark *) strong:is(.dark *) {\n  color: rgba(228, 228, 231, 1);\n}\n\n.dark\\:troubleshoot-admonition:is(.dark *) [data-callout-type=\"warning\"] .prose:is(.dark *),\n.dark\\:troubleshoot-admonition:is(.dark *) [data-callout-type=\"warning\"] .prose:is(.dark *) strong:is(.dark *) {\n  color: rgba(24, 24, 27, 1);\n}\n\n.dark\\:troubleshoot-admonition:is(.dark *) svg {\n  fill: rgba(228, 228, 231, 1);\n}\n\n.dark\\:troubleshoot-admonition:is(.dark *) .dark\\:bg-amber-500\\/10:is(.dark *) svg {\n  fill: none;\n}\n\n.dark\\:troubleshoot-admonition:is(.dark *) .code-group svg,\n.dark\\:troubleshoot-admonition:is(.dark *) .code-block svg {\n    fill: none;\n}\n\n/* stretching the divider lines to full length and matching the border color */\n.troubleshoot-admonition .prose hr.mint-my-3 {\n  margin-top: 1em;\n  margin-bottom: 1em;\n  margin-left: calc(-2.3rem - 0.75rem) !important;\n  margin-right: -1.25rem !important;\n  width: calc(100% + 2.5rem + 2rem) !important;\n  box-sizing: content-box;\n  display: block;\n  height: 0;\n  border: 0;\n  border-top: 1px solid rgba(113, 113, 122, .3);\n}\n\n/* Coloring and margins for any hr elements used inside troubleshooting element */\n\n.troubleshoot-admonition.troubleshoot-admonition .prose hr {\n    border-color: rgba(113, 113, 122, .3);\n    margin-top: 1em;\n    margin-bottom: 1em;\n}\n\n.dark .troubleshoot-admonition .prose .hr {\n  border-color: rgba(113, 113, 122, .3);\n  margin-top: 1em;\n  margin-bottom: 1em;\n}\n\n[data-callout-type=\"troubleshoot\"] h3 {\n    margin-top: 0;\n    font-size: 1em;\n    font-weight: 600;\n}\n\n[data-callout-type=\"troubleshoot\"] .-ml-10 {\n    margin-left: -4.5em;\n}\n\n/* ----------------- */\n/* MISCELLANEOUS CSS */\n/* ----------------- */\n\n/* Made tables full width of containers */\n\n.prose :where(table):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    display: table;\n}\n\n/* CSS from Mintlify I haven't figured out yet */\n\n.card .px-6.py-5 {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n}\n\n.px-6.py-5 {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n}\n\n.h-6.w-6 {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.mt-4 {\n  margin-top: 1rem; /* Adjust spacing for the heading */\n}\n\n.mt-1 {\n  margin-top: 0.25rem; /* Adjust spacing for the paragraph */\n}\n\n.text-sm {\n  font-size: 0.875rem;\n  line-height: 1.5;\n}\n\n/* Removes rounded corners from borders and hover background */\n\n.rounded-2xl {\n    border-radius: var(--rounded-xl, 6px);\n}\n\n.frame .rounded-2xl { /* Except for images */\n    border-radius: 0px;\n}\n  \n.rounded-xl {\n    border-radius: var(--rounded-xl, 6px);\n}\n\n.frame .rounded-xl { /* Except for images */\n    border-radius: 0px;\n}\n\n#topbar-cta-button .rounded-xl { /* Keeps CTA button with rounded corners */\n    border-radius: var(--rounded-xl, 6px);\n}\n  \n.rounded-t-xl {\n    border-radius: var(--rounded-xl, 6px);\n}\n\n.mint-rounded-2xl {\n    border-radius: var(--rounded-xl, 6px) !important;\n}\n\n.rounded-\\[14px\\] {\n    border-radius: var(--rounded-xl, 6px);\n}\n\n/* Banner color changes */\n\nhtml:not(.dark) #banner { /* light mode banner background */\n    background-color: var(--base-subtle-hsl) !important;\n}\n\nhtml:not(.dark) .\\[\\\u0026\\\u003e\\*\\]\\:text-white\\/90\u003e* { /* light mode banner text */\n    color: var(--on-base-rgb);\n}\n\n#banner { /* dark mode banner background */\n    background-color: var(--base-subtle-hsl-dark) !important;\n}\n\n.\\[\\\u0026\\\u003e\\*\\]\\:text-white\\/90\u003e* {\n    color: var(--on-base-rgb-dark);\n}\n\n/* Video embeds */\n\n.video {\n    display: flex;\n}\n\niframe {\n    min-width: 100%;\n    height: 350px;\n    margin: 0 auto;\n}\n\n@media (max-width: 640px) {\n    iframe {\n        height: 225px;\n    }\n}\n\n@media (min-width: 641px) and (max-width: 767px) {\n    iframe {\n        height: 275px;\n    }\n}\n\n/* Step component margin narrowing */\n\np[data-component-part=\"step-title\"] {\n    margin-bottom: .5rem;\n}\n\n[data-component-part=\"step-content\"] \u003e p { \n    margin-top: 10px; \n    margin-bottom: 10px;\n}\n\n/* Step component coloring */\n\n[data-component-part=\"step-number\"] .bg-gray-50 {\n    background-color: rgb(251 251 251);\n    border: solid 1px var(--kendo-color-base-border-rgb);\n}\n\n.dark [data-component-part=\"step-number\"] .bg-gray-50 {\n    background-color: rgb(32 37 53);\n    border: solid 1px rgba(251 251 251 / .14);\n}\n\n/* Fix tab and image spacing in lists */\n\nli .mb-6 {\n    margin-top: 0;\n}\n\nli .tabs {\n    margin-top: 1rem;\n    margin-bottom: 1rem;\n}\n\nli .accordion {\n    margin-top: 1rem;\n    margin-bottom: 1rem;\n}\n  \nli .accordion-group .accordion { /* Excludes accordion groups in lists from above rule */\n    margin-top: 0;\n    margin-bottom: 0;\n}\n\nli .frame {\n    margin-top: .5rem;\n}\n\n/* Turn sublist formatting to decimal */\n\n.prose :where(ol ol):not(:where([class~=not-prose],[class~=not-prose] *)) {\n    list-style-type: decimal;\n}\n\n/* Page tag coloring and formatting changes */\n\n.nav-tag-pill-text.text-primary {\n    color: rgb(var(--info-rgb));\n    border: .15rem solid rgb(var(--info-rgb));\n}\n\nhtml.dark .nav-tag-pill-text.dark\\:text-primary-light {\n    color: rgb(var(--info-rgb-dark));\n    border: .15rem solid rgb(var(--info-rgb-dark));\n}\n\n/* Ensures dark mode focus outline is the correct color */\nhtml.dark :focus {\n    outline-color: rgb(var(--info-rgb-dark));\n}\n\n/* Preview button (e.g. \"Install in Cursor\") */\n\n.preview-button {\n    background-color: rgb(var(--primary-rgb));\n    color: rgb(var(--on-primary-rgb)) !important;\n    text-decoration: none !important;\n    margin-left: 5px;\n}\n\n.preview-button:hover {\n    background-color: rgb(var(--primary-rgb) / 0.9);\n}\n\n.dark .preview-button {\n    background-color: rgb(var(--info-rgb-dark));\n    color: rgb(var(--on-primary-rgb)) !important;\n    text-decoration: none !important;\n}\n\n.dark .preview-button:hover {\n    background-color: rgb(var(--info-rgb-dark) / 0.9);\n}\n\n/* Install instructions CSS */\n\n#install-instructions-button.bg-primary-dark {\n    background-color: rgb(var(--primary-rgb));\n}\n\n#install-instructions-button:hover {\n    background-color: rgb(var(--primary-rgb) / 0.9);\n}\n\n#install-instructions-button.text-white,\n#install-instructions-button.mint-text-white {\n    color: rgb(var(--on-primary-rgb));\n}\n\n.dark #install-instructions-button.bg-primary-dark {\n    background-color: rgb(var(--info-rgb-dark));\n}\n\n.dark #install-instructions-button:hover {\n    background-color: rgb(var(--info-rgb-dark) / 0.9);\n}\n\n.dark #install-instructions-button.text-white,\n.dark #install-instructions-button.mint-text-white {\n    color: rgb(var(--on-primary-rgb));\n}\n\n.progress-indicator .bg-primary {\n    background-color: rgb(var(--primary-rgb));\n}\n\n.dark .progress-indicator .bg-primary {\n    background-color: rgb(var(--info-rgb-dark));\n}\n\n/* Horizontal rule color changes */\n\n.prose hr:not(.callout hr) {\n    border-color: rgb(var(--on-primary-rgb) / .5);\n}\n\n.prose hr:not(.callout hr):is(.dark *) {\n    border-color: rgb(var(--on-secondary-rgb-dark) / .5);\n}\n\n/* ---------------- */\n/* DEFINITION LISTS */\n/* ---------------- */\n\n.definition-list {\n  margin-top: 0.5rem;     /* shrink top spacing */\n  margin-bottom: 0.5rem;  /* shrink bottom spacing */\n}\n\n/* Term line */\n.definition-term {\n  margin-top: 0.5rem;     /* space above each term */\n  margin-bottom: 0.1rem;  /* reduce gap between term and description */\n}\n\n/* Term coloring dark mode */\n.dark .prose dt.definition-term {\n    --tw-prose-headings: rgb(251 251 251);\n    color: var(--tw-prose-headings);\n}\n\n/* Description line(s) */\n.definition-description {\n  margin: 0 0 0.5rem 0;   /* space after each description, no extra top margin */\n}\n\n/* ---------------- */\n/*   API CALLOUTS   */\n/* ---------------- */\n\n/* Ensure API Path text color inherits our light text color in dark mode */\nhtml.dark .text-gray-400 {\n  color: rgb(var(--on-secondary-rgb-dark)) !important;\n}\n\n/* ------------------------------------------- */\n/* GRID TABLE - CSS Grid-based, Mintlify-proof */\n/* ------------------------------------------- */\n\n.grid-table {\n  border: 1px solid rgba(96, 99, 106, 0.16);\n  background-color: rgb(251 251 251);\n  font-size: 0.875rem;\n}\n\nhtml.dark .grid-table {\n  border-color: rgba(113, 113, 122, 0.3);\n  background-color: rgb(32 37 53);\n}\n\n.grid-table-head {\n  background-color: rgba(233, 235, 242, 0.9);\n  border-bottom: 1px solid rgba(96, 99, 106, 0.16);\n}\n\nhtml.dark .grid-table-head {\n  background-color: rgba(48, 55, 79, 0.8);\n  border-bottom-color: rgba(113, 113, 122, 0.3);\n}\n\n.grid-table-body {\n  background-color: rgb(251 251 251);\n}\n\nhtml.dark .grid-table-body {\n  background-color: rgb(32 37 53);\n}\n\n.grid-table-row {\n  display: grid;\n  grid-template-columns: var(--grid-table-cols, 1fr 1fr);\n  align-items: start;\n  border-bottom: 1px solid rgba(96, 99, 106, 0.1);\n}\n\n.grid-table-row:last-child {\n  border-bottom: none;\n}\n\nhtml.dark .grid-table-row {\n  border-bottom-color: rgba(113, 113, 122, 0.2);\n}\n\n/* Remove border from header row (handled by grid-table-head border-bottom) */\n.grid-table-head .grid-table-row {\n  border-bottom: none;\n}\n\n.grid-table-th {\n  text-align: left;\n  font-weight: 600;\n  font-family: 'Inter', 'Inter Fallback', sans-serif;\n  padding: 0.75rem 1rem;\n  color: rgb(var(--on-primary-rgb));\n}\n\nhtml.dark .grid-table-th {\n  color: var(--on-base-rgb-dark);\n}\n\n.grid-table-cell {\n  padding: 0.75rem 1rem;\n  color: rgb(var(--on-primary-rgb));\n}\n\n/* Lists in grid table cells (table uses not-prose so list styles are opt-in) */\n.grid-table-cell ul {\n  list-style-type: disc;\n  padding-left: 1.25rem;\n  margin: 0.25rem 0 0 0;\n}\n.grid-table-cell ul:first-child {\n  margin-top: 0;\n}\n.grid-table-cell li {\n  margin: 0.125rem 0;\n}\n.grid-table-cell li:first-child {\n  margin-top: 0;\n}\n.grid-table-cell li:last-child {\n  margin-bottom: 0;\n}\n\nhtml.dark .grid-table-cell {\n  color: rgb(var(--on-secondary-rgb-dark));\n}\n\n/* Inline code styling in grid tables */\n.grid-table-cell code {\n  background-color: hsla(210, 14%, 97%, 1);\n  border: 1px solid hsla(222, 5%, 40%, 0.25);\n  color: #3f496a;\n  padding: 0.125rem 0.375rem;\n  border-radius: 4px;\n  font-size: 0.875em;\n}\n\nhtml.dark .grid-table-cell code {\n  background-color: hsla(228, 5%, 21%, 1);\n  border-color: hsla(222, 5%, 40%, 0.25);\n  color: #dee2eb;\n}\n\n/* Add margin to grid table after frame */\n\ndiv:has(\u003e .frame) + .grid-table {\n    margin-top: 1rem;\n  }\n\n/* ----------------------- */\n/* PRODUCT SWITCHER CSS */\n/* ----------------------- */\n\n/* Make the product switcher more visually prominent */\n[data-component-part=\"products-selector-trigger\"] {\n    font-weight: 600;\n    border: 1.5px solid var(--info-hex);\n    border-radius: 6px;\n    padding: 4px 10px;\n    transition: all 0.2s ease;\n}\n\n[data-component-part=\"products-selector-trigger\"]:hover {\n    background-color: rgba(29, 108, 247, 0.08) !important;\n    border-color: var(--info-hex);\n}\n\nhtml.dark [data-component-part=\"products-selector-trigger\"] {\n    border-color: var(--info-hex-dark);\n}\n\nhtml.dark [data-component-part=\"products-selector-trigger\"]:hover {\n    background-color: rgba(150, 247, 120, 0.08) !important;\n    border-color: var(--info-hex-dark);\n}\n\n/* Product dropdown custom SVG icon - match Font Awesome icon colors */\nimg[src*=\"anaconda-icon\"] {\n    filter: brightness(0);\n}\n\nhtml.dark img[src*=\"anaconda-icon\"] {\n    filter: brightness(0) invert(1);\n}\n\n/* ------------------- */\n/* MERMAID DIAGRAM CSS */\n/* ------------------- */\n\n/* Make mermaid diagram pan/zoom controls mostly transparent */\n[data-component-name=\"mermaid-controls-wrapper\"] {\n    opacity: 0.1;\n    transition: opacity 0.2s ease;\n}\n\n[data-component-name=\"mermaid-controls-wrapper\"]:hover {\n    opacity: 0.8;\n}\n"])</script><script>self.__next_f.push([1,"50:[\"$\",\"$L51\",null,{\"pageMetadata\":\"$20:props:children:props:pageMetadata\",\"mdxExtracts\":\"$20:props:children:props:children:props:children:props:value:mdxExtracts\",\"openApiReferenceData\":\"$undefined\",\"children\":[\"$\",\"$L52\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$53\"}}],[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"center\\\");\"}}],[\"$\",\"$L54\",null,{\"mode\":\"center\"}]],[\"$\",\"$L55\",null,{\"pageMetadata\":\"$20:props:children:props:pageMetadata\"}],[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"custom.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$56\"}}]],\"$L57\",\"$L58\"]}]}]\n"])</script><script>self.__next_f.push([1,"59:I[36098,[\"/docs/_next/static/chunks/ef1439d5f668da9d.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/f22b6d799a488f6d.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/3bfb848042f90c6d.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/bbb8cb0debad8234.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/341fe1ea423a127e.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/cc02dce2006693a4.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/d44defd5d0db8d9d.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/14c6aaf76b9694fd.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/9f1fac9429874bfb.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/289c77d72ef8271a.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/83e75b60d891d2a1.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/ea1412909055a817.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/86d80384f77bdfc9.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/937ab3bfb9adab6e.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/01f4b20cb37151b1.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/ed6a129439d553b4.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/8b7a6316c3557781.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/_next/static/chunks/973b0453c9add2a6.js?dpl=dpl_EDDG68QZYJjsx25Fu5A4QBHnKtiy\",\"/docs/